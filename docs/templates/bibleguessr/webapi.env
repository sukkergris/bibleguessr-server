ASPNETCORE_URLS=http://+:8080

ASPNETCORE_ENVIRONMENT=Production
Logging__LogLevel__Default=Warning
# Logging__LogLevel__Microsoft.AspNetCore=Warning MOVED since bash can't undderstand . in the keyname

# SQLite database (v0.0.5+): the image already sets this, so leave it unset.
# Override only to move the file, and keep it under /data/db (the game-db
# volume in docker-compose.yml) or it is lost on the next deploy.
# Database__FilePath=/data/db/bibleguessr.db