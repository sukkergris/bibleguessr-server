# HTTP redirect
server {
    listen 80;
    access_log /dev/stdout realip;
    server_name ${DOMAIN_HVT} www.${DOMAIN_HVT};

    if ($bad_guys = 1) {
        return 302 $scheme://$host$request_uri;
    }

    include includes/tarpit.conf;

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt_challenges;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS main site
server {
    listen 443 ssl;
    http2 on;
    access_log /dev/stdout realip;
    server_name ${DOMAIN_HVT} www.${DOMAIN_HVT};

    if ($bad_guys = 1) {
        return 302 $scheme://$host$request_uri;
    }

    include includes/tarpit.conf;

    ssl_certificate /etc/letsencrypt/live/${DOMAIN_HVT}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_HVT}/privkey.pem;
    include includes/ssl-params.conf;

    location /cms/ {
        # Trailing slash strips the /cms/ prefix so Squidex receives clean paths.
        include includes/proxy-squidex.conf;
    }

    location /api/ {
        limit_req zone=api_limit burst=20 nodelay;
        limit_req_status 429;
        include includes/proxy-webapi.conf;
        include includes/cache-control.conf;
    }

    # location /cms/ {
    #     proxy_pass $yarp_upstream;
    #     rewrite ^/cms/(.*)$ /$1 break;
    #     add_header Cache-Control 'no-cache';
    #     expires 0;
    #     include includes/proxy-params.conf;
    # }

    location = /sitemap.xml {
        include includes/proxy-webapi.conf;
        include includes/cache-control.conf;
    }

    set $site_root /usr/share/nginx/html/habibi-vip-taxi;

    include includes/static-assets.conf;

    set $nginx_env_name "${NGINX_ENV_NAME}";
    set $nginx_gtag_id "GTM-NK3XW48N";
    set $nginx_pixel_id "1470367793989555";
    set $squidex_upstream "http://squidex:5000";
    set $web_api_upstream "http://webapi:8080";
    set $yarp_upstream "http://host.docker.internal:5140";

    location / {
        root $site_root;
        try_files $uri @prerender_miss;
    }

    location /prerender-static/ {
        internal;
        alias /var/prerender/;
        try_files $uri/index.html $uri.html @prerender_miss;
        add_header X-Prerender-Served "static" always;
        expires 1h;
    }

    location @prerender_miss {
        root $site_root;
        try_files $uri /index.html;
        add_header Cache-Control 'no-cache, must-revalidate';

        sub_filter_once off;
        sub_filter '__ENVIRONMENT_NAME__'      "$nginx_env_name";
        sub_filter '__GOOGLE_TAG_MANAGER_ID__' "$nginx_gtag_id";
        sub_filter '__PIXEL_ID__'              "$nginx_pixel_id";

        expires 0;
    }
}