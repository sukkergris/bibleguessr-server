# HTTP redirect
server {
    listen 80;
    server_name squidex.${DOMAIN_HVT} www.squidex.${DOMAIN_HVT};

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt_challenges;
        try_files $uri =404;
        access_log off;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS Squidex
server {
    listen 443 ssl;
    server_name squidex.${DOMAIN_HVT} www.squidex.${DOMAIN_HVT};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN_HVT}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_HVT}/privkey.pem;
    include includes/ssl-params.conf;

    client_max_body_size 200M;

    set $squidex_upstream "http://squidex:5000";

    location / {
        proxy_pass $squidex_upstream;
        proxy_http_version 1.1;
        include includes/proxy-params.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
